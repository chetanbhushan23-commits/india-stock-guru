# ChetanMarkets AI — server-side providers
# Never put secrets in VITE_* variables or frontend code.

# -----------------------------
# AI — Gemini research default
# -----------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Local fallback — no API key required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Optional alternative cloud provider.
OPENAI_API_KEY=

# -----------------------------
# Market data
# -----------------------------
# Yahoo Finance is the default server-side market-data source and does not
# use a YAHOO_API_KEY variable.

# Optional secondary market-data fallback. Leave blank if unused.
TWELVE_DATA_API_KEY=

# -----------------------------
# Research/source behavior
# -----------------------------
# Keep official/primary sources ahead of secondary aggregators.
SOURCE_PRIMARY_ONLY_FOR_VERIFICATION=true
ALLOW_SECONDARY_RESEARCH_SOURCES=true
ALLOW_STALE_CACHE=false
