# ChetanMarkets AI — server-side market data
# Yahoo Finance is the default market-data source and does not require an API key here.
# Keep all provider credentials server-side; never expose them in VITE_* variables.

# Optional secondary market-data fallback. Leave blank if unused.
TWELVE_DATA_API_KEY=

# Optional AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=
